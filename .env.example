# Copy to .env (gitignored). Real environment variables override this file.
# required; added to every log line
APP_NAME=privatebin-go
LOG_LEVEL=info
LISTEN_ADDR=:8080
# serves Prometheus metrics on the app port at /metrics (unauthenticated: restrict it at the proxy)
METRICS_ENABLED=true
BASE_URL=http://localhost:8080
MAX_PASTE_BYTES=2097152
# serves /swagger/ and /openapi.yaml
SWAGGER_ENABLED=true

# page: name in the title, nav and footer; footer HTML (e.g. a link); prettify theme for
# source code: empty, desert, doxy, sons-of-obsidian or sunburst
APP_TITLE=privatebin-go
PAGE_INFO=
SYNTAX_THEME=
# preselect "Burn after reading" in the interface (true/false); users can still change it per paste
BURN_AFTER_READING_DEFAULT=true
# comma separated proxy IPs/CIDRs whose X-Forwarded-For is trusted; empty = none
TRUSTED_PROXIES=

DATABASE_URL=postgres://privatebin:privatebin@localhost:5432/privatebin?sslmode=disable
# PrivateBin "tbl" option
TABLE_PREFIX=
# HMAC key for delete tokens
DELETE_SALT=change-me-generate-with-openssl-rand-hex-32

# database container started by `docker compose up -d db` (host port: change POSTGRES_PORT
# and the port in DATABASE_URL together if 5432 is taken)
POSTGRES_PORT=5432
POSTGRES_USER=privatebin
POSTGRES_PASSWORD=privatebin
POSTGRES_DB=privatebin

# Optional Dex login gating paste creation (docker compose --profile auth up)
AUTH_ENABLED=false
OIDC_ISSUER=http://localhost:5556/dex
OIDC_CLIENT_ID=privatebin-go
OIDC_CLIENT_SECRET=change-me
SESSION_SECRET=change-me-generate-with-openssl-rand-hex-32
